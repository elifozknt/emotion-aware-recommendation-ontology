<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/emotion-aware-recommendation#EmotionAwareRecommendationOntology#"
     xml:base="http://example.org/emotion-aware-recommendation#EmotionAwareRecommendationOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/"
     xmlns:emotion-aware-recommendation="http://example.org/emotion-aware-recommendation#">
    <owl:Ontology rdf:about="http://example.org/emotion-aware-recommendation#EmotionAwareRecommendationOntology">
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-28</terms:created>
        <terms:creator xml:lang="en">Büşra Pehlivanlar</terms:creator>
        <terms:creator xml:lang="en">Elif Özkanat</terms:creator>
        <terms:creator xml:lang="en">Enes Ulucan</terms:creator>
        <terms:description xml:lang="en">This ontology models an intelligent recommendation system that provides personalized content suggestions based on the user&apos;s emotional state, contextual situation, personality traits, and needs. Phase 2 adds DynamicEmotion, BehaviorProfile, EmotionSession, UserInteraction, and DataSource classes inspired by Norouzi et al. (2025) ontology population with LLMs and Fernandez et al. (2023) GRU-RNN behavioral prediction.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-14</terms:modified>
        <terms:publisher xml:lang="en">Manisa Celal Bayar University</terms:publisher>
        <terms:title xml:lang="en">Emotion-Aware Intelligent Recommendation Ontology</terms:title>
        <vann:preferredNamespacePrefix>ex</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://example.org/emotion-aware-recommendation#</vann:preferredNamespaceUri>
        <rdfs:comment xml:lang="en">An ontology for modeling personalized recommendations based on user emotions, needs, context, personality traits, preferences, content types, and content effects. Version 2 extends the ontology with dynamic emotion tracking, behavioral prediction, LLM-based population support, and session-level interaction modeling.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotion-Aware Intelligent Recommendation Ontology</rdfs:label>
        <owl:priorVersion>1.0.0</owl:priorVersion>
        <owl:versionInfo>2.0.0</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/elifozknt/emotion-aware-recommendation-ontology"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- https://schema.org/codeRepository -->


    <owl:AnnotationProperty rdf:about="https://schema.org/codeRepository"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/emotion-aware-recommendation#availableOnPlatform -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#availableOnPlatform">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Platform"/>
        <rdfs:comment xml:lang="en">Connects content to the platform where it is available.</rdfs:comment>
        <rdfs:label xml:lang="en">available on platform</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#basedOnEmotion -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#basedOnEmotion">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">Shows the emotion considered in a recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">based on emotion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#basedOnNeed -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#basedOnNeed">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Need"/>
        <rdfs:comment xml:lang="en">Shows the need considered in a recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">based on need</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#belongsToCategory -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#belongsToCategory">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#ContentCategory"/>
        <rdfs:comment xml:lang="en">Connects content to its category.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#changesOverTime -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#changesOverTime">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#DynamicEmotion"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#DynamicEmotion"/>
        <rdfs:comment xml:lang="en">Links two dynamic emotion states to represent temporal transitions, enabling temporal reasoning over emotional trajectories.</rdfs:comment>
        <rdfs:label xml:lang="en">changes over time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#considersContext -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#considersContext">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Context"/>
        <rdfs:comment xml:lang="en">Shows contextual information used in a recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">considers context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#createsNeed -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#createsNeed">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Need"/>
        <rdfs:comment xml:lang="en">Connects an emotion to the need it may create.</rdfs:comment>
        <rdfs:label xml:lang="en">creates need</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#derivedFromContext -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#derivedFromContext">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#DynamicEmotion"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Context"/>
        <rdfs:comment xml:lang="en">Links a dynamic emotion state to the contextual factors (time, environment) that contributed to it.</rdfs:comment>
        <rdfs:label xml:lang="en">derived from context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#feels -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#feels">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">Connects a user to an emotion they experience.</rdfs:comment>
        <rdfs:label xml:lang="en">feels</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#givenTo -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#givenTo">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:comment xml:lang="en">Connects a recommendation to the user receiving it.</rdfs:comment>
        <rdfs:label xml:lang="en">given to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasBehaviorProfile -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasBehaviorProfile">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#BehaviorProfile"/>
        <rdfs:comment xml:lang="en">Connects a user to their predicted behavior profile (e.g., Cognitive, Speed, Sedentary, Aggressive), as classified by the GRU-RNN behavioral model described in Fernandez et al. (2023).</rdfs:comment>
        <rdfs:label xml:lang="en">has behavior profile</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasDynamicEmotion -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasDynamicEmotion">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#DynamicEmotion"/>
        <rdfs:comment xml:lang="en">Connects a user to a temporally-tracked dynamic emotion state recorded within a session.</rdfs:comment>
        <rdfs:label xml:lang="en">has dynamic emotion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasEffect -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasEffect">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Effect"/>
        <rdfs:comment xml:lang="en">Connects content to its expected effect.</rdfs:comment>
        <rdfs:label xml:lang="en">has effect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasFeedback -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasFeedback">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Feedback"/>
        <rdfs:comment xml:lang="en">Connects a recommendation to user feedback.</rdfs:comment>
        <rdfs:label xml:lang="en">has feedback</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasIntention -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasIntention">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Intention"/>
        <rdfs:comment xml:lang="en">Shows the intended purpose of a recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">has intention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasInteraction -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasInteraction">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#EmotionSession"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#UserInteraction"/>
        <rdfs:comment xml:lang="en">Connects an emotion session to individual user interaction events within it.</rdfs:comment>
        <rdfs:label xml:lang="en">has interaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasNeed -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasNeed">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Need"/>
        <rdfs:comment xml:lang="en">Connects a user to a need.</rdfs:comment>
        <rdfs:label xml:lang="en">has need</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasPersonality -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasPersonality">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">Connects a user to a personality trait.</rdfs:comment>
        <rdfs:label xml:lang="en">has personality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasPreference -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasPreference">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Preference"/>
        <rdfs:comment xml:lang="en">Connects a user to a preference.</rdfs:comment>
        <rdfs:label xml:lang="en">has preference</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasTimeContext -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#hasTimeContext">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#TimeContext"/>
        <rdfs:comment xml:lang="en">Connects a user to a time context.</rdfs:comment>
        <rdfs:label xml:lang="en">has time context</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#includesContent -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#includesContent">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:comment xml:lang="en">Connects a recommendation to the content it includes.</rdfs:comment>
        <rdfs:label xml:lang="en">includes content</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#interactedWith -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#interactedWith">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#UserInteraction"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:comment xml:lang="en">Connects an interaction event to the content item the user acted on.</rdfs:comment>
        <rdfs:label xml:lang="en">interacted with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#isInEnvironment -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#isInEnvironment">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Environment"/>
        <rdfs:comment xml:lang="en">Connects a user to an environment.</rdfs:comment>
        <rdfs:label xml:lang="en">is in environment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#matchesPreference -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#matchesPreference">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Preference"/>
        <rdfs:comment xml:lang="en">Connects content to a matching user preference.</rdfs:comment>
        <rdfs:label xml:lang="en">matches preference</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#populatedFrom -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#populatedFrom">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#UserInteraction"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#DataSource"/>
        <rdfs:comment xml:lang="en">Documents the data source from which this interaction instance was extracted, supporting the provenance tracking approach of Norouzi et al. (2025).</rdfs:comment>
        <rdfs:label xml:lang="en">populated from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#recordedInSession -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#recordedInSession">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#DynamicEmotion"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#EmotionSession"/>
        <rdfs:comment xml:lang="en">Links a dynamic emotion observation to the session in which it was recorded.</rdfs:comment>
        <rdfs:label xml:lang="en">recorded in session</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#relievesEmotion -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#relievesEmotion">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Effect"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">Connects an effect to an emotion it may help reduce.</rdfs:comment>
        <rdfs:label xml:lang="en">relieves emotion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#satisfiedBy -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#satisfiedBy">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Need"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:comment xml:lang="en">Connects a need to content that can satisfy it.</rdfs:comment>
        <rdfs:label xml:lang="en">satisfied by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#suitableForEnvironment -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#suitableForEnvironment">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Environment"/>
        <rdfs:comment xml:lang="en">Shows which environment is suitable for content.</rdfs:comment>
        <rdfs:label xml:lang="en">suitable for environment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#suitableForPersonality -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#suitableForPersonality">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">Shows which personality type a content item is suitable for.</rdfs:comment>
        <rdfs:label xml:lang="en">suitable for personality</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#suitableForTime -->


    <owl:ObjectProperty rdf:about="http://example.org/emotion-aware-recommendation#suitableForTime">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://example.org/emotion-aware-recommendation#TimeContext"/>
        <rdfs:comment xml:lang="en">Shows which time context is suitable for content.</rdfs:comment>
        <rdfs:label xml:lang="en">suitable for time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/emotion-aware-recommendation#hasAge -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasAge">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">has age</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasConfidenceScore -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasConfidenceScore">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Recommendation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label xml:lang="en">has confidence score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasDurationMinutes -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasDurationMinutes">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">has duration in minutes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasFeedbackScore -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasFeedbackScore">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#Feedback"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">has feedback score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasIntensityLevel -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasIntensityLevel">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#DynamicEmotion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">A numeric score (0.0–1.0) representing the intensity of a dynamic emotion at the time of observation.</rdfs:comment>
        <rdfs:label xml:lang="en">has intensity level</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasInteractionType -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasInteractionType">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#UserInteraction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The type of user interaction (e.g., &apos;play&apos;, &apos;skip&apos;, &apos;complete&apos;, &apos;like&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">has interaction type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasSourceURL -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasSourceURL">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#DataSource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/emotion-aware-recommendation#hasTimestamp -->


    <owl:DatatypeProperty rdf:about="http://example.org/emotion-aware-recommendation#hasTimestamp">
        <rdfs:domain rdf:resource="http://example.org/emotion-aware-recommendation#EmotionSession"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">The date-time when the emotion session was recorded.</rdfs:comment>
        <rdfs:label xml:lang="en">has timestamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/emotion-aware-recommendation#AgreeablePersonality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#AgreeablePersonality">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">A personality type characterized by cooperativeness, empathy, and trust. Agreeable users tend to enjoy emotionally warm content (e.g., feel-good movies, collaborative games, uplifting podcasts).</rdfs:comment>
        <rdfs:label xml:lang="en">Agreeable Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#BehaviorProfile -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#BehaviorProfile">
        <rdfs:comment xml:lang="en">A classification of the user&apos;s interaction behavior style, analogous to the four behavioral classes (Cognitive, Speed, Sedentary, Aggressive) predicted by Fernandez et al. (2023). Used to personalize recommendation frequency and content depth.</rdfs:comment>
        <rdfs:label xml:lang="en">Behavior Profile</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#ConscientiousPersonality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#ConscientiousPersonality">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">A personality type characterized by organization, goal-directedness, and discipline. Conscientious users prefer structured, purposeful content (e.g., educational podcasts, productivity music, self-improvement content).</rdfs:comment>
        <rdfs:label xml:lang="en">Conscientious Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Content -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Content">
        <rdfs:comment xml:lang="en">A digital content item or activity that can be recommended to a user.</rdfs:comment>
        <rdfs:label xml:lang="en">Content</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#ContentCategory -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#ContentCategory">
        <rdfs:comment xml:lang="en">A category describing the type of content.</rdfs:comment>
        <rdfs:label xml:lang="en">Content Category</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Context -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Context">
        <rdfs:comment xml:lang="en">The situation in which the user is located.</rdfs:comment>
        <rdfs:label xml:lang="en">Context</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#DataSource -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#DataSource">
        <rdfs:comment xml:lang="en">A source of data used to populate the ontology with instances (e.g., Kaggle dataset, Spotify API, survey). Supports the data provenance tracking recommended by Norouzi et al. (2025) for LLM-based knowledge graph population.</rdfs:comment>
        <rdfs:label xml:lang="en">Data Source</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#DynamicEmotion -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#DynamicEmotion">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">An emotion state that changes over time and is tracked across multiple sessions. Inspired by the temporal behavioral modeling in Fernandez et al. (2023) GRU-RNN framework, which predicts evolving user behavior styles across sessions.</rdfs:comment>
        <rdfs:label xml:lang="en">Dynamic Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Effect -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Effect">
        <rdfs:comment xml:lang="en">The expected psychological or behavioral effect of a content item.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Emotion -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Emotion">
        <rdfs:comment xml:lang="en">An emotional state experienced by a user. Inspired by the UniEmotion ontology (Kim 2013) and Kim &amp; Lee (2015) emotion ontology for recommendation, emotions are categorized as Positive, Negative, or Neutral/Factual.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#EmotionSession -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#EmotionSession">
        <rdfs:comment xml:lang="en">A bounded time window during which a user&apos;s emotional state and interactions are recorded. Enables longitudinal modeling of emotion change, supporting the dynamic emotion tracking capability.</rdfs:comment>
        <rdfs:label xml:lang="en">Emotion Session</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Environment -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Environment">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Context"/>
        <rdfs:comment xml:lang="en">The physical or social environment of a user.</rdfs:comment>
        <rdfs:label xml:lang="en">Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#ExtrovertedPersonality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#ExtrovertedPersonality">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">A personality type characterized by sociability, high energy, and preference for stimulating environments. Extroverted users tend to prefer social, upbeat, or group-oriented content (e.g., party playlists, group films).</rdfs:comment>
        <rdfs:label xml:lang="en">Extroverted Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Feedback -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Feedback">
        <rdfs:comment xml:lang="en">A user response to a recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">Feedback</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Intention -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Intention">
        <rdfs:comment xml:lang="en">The intended purpose of a recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">Intention</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#IntrovertedPersonality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#IntrovertedPersonality">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">A personality type characterized by preference for solitary activities, deep focus, and low-stimulation environments. Introverted users tend to prefer calm, solo content (e.g., lo-fi music, meditation, solo games).</rdfs:comment>
        <rdfs:label xml:lang="en">Introverted Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Need -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Need">
        <rdfs:comment xml:lang="en">A user need that may arise from an emotional state.</rdfs:comment>
        <rdfs:label xml:lang="en">Need</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#NegativeEmotion -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#NegativeEmotion">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">An emotion associated with unpleasant or unfavorable affective states. Corresponds to &apos;negative emotional tags&apos; in the UniEmotion ontology (Kim 2013). Examples: stress, sadness, anxiety, tiredness.</rdfs:comment>
        <rdfs:label xml:lang="en">Negative Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#NeuroticlPersonality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#NeuroticlPersonality">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">A personality type characterized by emotional instability and high sensitivity to stress. Neurotic users benefit most from calming, grounding content (e.g., meditation, nature soundscapes, breathing exercises).</rdfs:comment>
        <rdfs:label xml:lang="en">Neurotic Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#NeutralEmotion -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#NeutralEmotion">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">A factual or neutral affective state with neither strong positive nor negative valence. Corresponds to &apos;factual tags&apos; in the UniEmotion ontology (Kim 2013). Examples: calmness, focus, boredom.</rdfs:comment>
        <rdfs:label xml:lang="en">Neutral Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#OpennessPersonality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#OpennessPersonality">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Personality"/>
        <rdfs:comment xml:lang="en">A personality type characterized by curiosity, creativity, and appreciation of art. Users high in openness tend to enjoy diverse, novel, or artistic content (e.g., experimental music, documentaries, creative games).</rdfs:comment>
        <rdfs:label xml:lang="en">Openness Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Personality -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Personality">
        <rdfs:comment xml:lang="en">A personality trait based on the Big Five model that may affect recommendation suitability. Sub-classes represent the primary personality dimensions relevant to emotion-based recommendation.</rdfs:comment>
        <rdfs:label xml:lang="en">Personality</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Platform -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Platform">
        <rdfs:comment xml:lang="en">A digital platform where content may be delivered.</rdfs:comment>
        <rdfs:label xml:lang="en">Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#PositiveEmotion -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#PositiveEmotion">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Emotion"/>
        <rdfs:comment xml:lang="en">An emotion associated with pleasant, favorable affective states. Corresponds to &apos;positive emotional tags&apos; in the UniEmotion ontology (Kim 2013). Examples: happiness, excitement, contentment.</rdfs:comment>
        <rdfs:label xml:lang="en">Positive Emotion</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Preference -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Preference">
        <rdfs:comment xml:lang="en">A user&apos;s preferred content type or activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Preference</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#Recommendation -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#Recommendation">
        <rdfs:comment xml:lang="en">A personalized suggestion generated for a user.</rdfs:comment>
        <rdfs:label xml:lang="en">Recommendation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#TimeContext -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#TimeContext">
        <rdfs:subClassOf rdf:resource="http://example.org/emotion-aware-recommendation#Context"/>
        <rdfs:comment xml:lang="en">The time-related context of a user.</rdfs:comment>
        <rdfs:label xml:lang="en">Time Context</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#User -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#User">
        <rdfs:comment xml:lang="en">A person who receives recommendations from the system.</rdfs:comment>
        <rdfs:label xml:lang="en">User</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/emotion-aware-recommendation#UserInteraction -->


    <owl:Class rdf:about="http://example.org/emotion-aware-recommendation#UserInteraction">
        <rdfs:comment xml:lang="en">A single recorded interaction event between a user and a recommended content item (e.g., play, skip, complete). Used to populate ontology instances from log data, as described in the LLM-based ontology population approach of Norouzi et al. (2025).</rdfs:comment>
        <rdfs:label xml:lang="en">User Interaction</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/emotion-aware-recommendation#AggressiveBehavior -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#AggressiveBehavior">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#BehaviorProfile"/>
        <rdfs:comment xml:lang="en">User who skips content frequently, indicating high selectivity or stress.</rdfs:comment>
        <rdfs:label xml:lang="en">Aggressive Behavior</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#AgreeableUser -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#AgreeableUser">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#AgreeablePersonality"/>
        <rdfs:comment xml:lang="en">Agreeable personality individual — enjoys emotionally warm, cooperative content.</rdfs:comment>
        <rdfs:label xml:lang="en">Agreeable User</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Alone -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#Alone">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#Environment"/>
        <rdfs:label xml:lang="en">Alone</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Anxiety -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#Anxiety">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#NegativeEmotion"/>
        <emotion-aware-recommendation:createsNeed rdf:resource="http://example.org/emotion-aware-recommendation#Calmness"/>
        <rdfs:label xml:lang="en">Anxiety</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Boredom -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#Boredom">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#NeutralEmotion"/>
        <emotion-aware-recommendation:createsNeed rdf:resource="http://example.org/emotion-aware-recommendation#Distraction"/>
        <rdfs:label xml:lang="en">Boredom</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#BreathingExercise -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#BreathingExercise">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <emotion-aware-recommendation:availableOnPlatform rdf:resource="http://example.org/emotion-aware-recommendation#MobileApp"/>
        <emotion-aware-recommendation:belongsToCategory rdf:resource="http://example.org/emotion-aware-recommendation#Meditation"/>
        <emotion-aware-recommendation:hasEffect rdf:resource="http://example.org/emotion-aware-recommendation#RelaxingEffect"/>
        <emotion-aware-recommendation:suitableForEnvironment rdf:resource="http://example.org/emotion-aware-recommendation#Home"/>
        <emotion-aware-recommendation:suitableForPersonality rdf:resource="http://example.org/emotion-aware-recommendation#Introvert"/>
        <emotion-aware-recommendation:suitableForTime rdf:resource="http://example.org/emotion-aware-recommendation#Night"/>
        <emotion-aware-recommendation:hasDurationMinutes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</emotion-aware-recommendation:hasDurationMinutes>
        <rdfs:label xml:lang="en">Breathing Exercise</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Busra -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#Busra">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <emotion-aware-recommendation:feels rdf:resource="http://example.org/emotion-aware-recommendation#Boredom"/>
        <emotion-aware-recommendation:hasNeed rdf:resource="http://example.org/emotion-aware-recommendation#Distraction"/>
        <emotion-aware-recommendation:hasPersonality rdf:resource="http://example.org/emotion-aware-recommendation#Extrovert"/>
        <emotion-aware-recommendation:hasPreference rdf:resource="http://example.org/emotion-aware-recommendation#LikesGames"/>
        <emotion-aware-recommendation:hasTimeContext rdf:resource="http://example.org/emotion-aware-recommendation#Evening"/>
        <emotion-aware-recommendation:isInEnvironment rdf:resource="http://example.org/emotion-aware-recommendation#Home"/>
        <emotion-aware-recommendation:hasAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22</emotion-aware-recommendation:hasAge>
        <rdfs:label xml:lang="en">Büşra</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#CalmingEffect -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#CalmingEffect">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#Effect"/>
        <emotion-aware-recommendation:relievesEmotion rdf:resource="http://example.org/emotion-aware-recommendation#Anxiety"/>
        <emotion-aware-recommendation:relievesEmotion rdf:resource="http://example.org/emotion-aware-recommendation#Stress"/>
        <rdfs:label xml:lang="en">Calming Effect</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Calmness -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#Calmness">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#Need"/>
        <emotion-aware-recommendation:satisfiedBy rdf:resource="http://example.org/emotion-aware-recommendation#MeditationAudio"/>
        <rdfs:label xml:lang="en">Calmness</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#CognitiveBehavior -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#CognitiveBehavior">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#BehaviorProfile"/>
        <rdfs:comment xml:lang="en">User who engages deeply with content, high intellectual processing.</rdfs:comment>
        <rdfs:label xml:lang="en">Cognitive Behavior</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#ComfortMovie -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#ComfortMovie">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#Content"/>
        <emotion-aware-recommendation:availableOnPlatform rdf:resource="http://example.org/emotion-aware-recommendation#Netflix"/>
        <emotion-aware-recommendation:belongsToCategory rdf:resource="http://example.org/emotion-aware-recommendation#Movie"/>
        <emotion-aware-recommendation:hasEffect rdf:resource="http://example.org/emotion-aware-recommendation#EmotionalReliefEffect"/>
        <emotion-aware-recommendation:matchesPreference rdf:resource="http://example.org/emotion-aware-recommendation#LikesMovies"/>
        <emotion-aware-recommendation:suitableForEnvironment rdf:resource="http://example.org/emotion-aware-recommendation#WithFriends"/>
        <emotion-aware-recommendation:suitableForPersonality rdf:resource="http://example.org/emotion-aware-recommendation#Extrovert"/>
        <emotion-aware-recommendation:suitableForTime rdf:resource="http://example.org/emotion-aware-recommendation#Evening"/>
        <emotion-aware-recommendation:hasDurationMinutes rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95</emotion-aware-recommendation:hasDurationMinutes>
        <rdfs:label xml:lang="en">Comfort Movie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#ConscientiousUser -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#ConscientiousUser">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#ConscientiousPersonality"/>
        <rdfs:comment xml:lang="en">Conscientious personality individual — prefers structured, educational content.</rdfs:comment>
        <rdfs:label xml:lang="en">Conscientious User</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Deniz -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#Deniz">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#User"/>
        <emotion-aware-recommendation:feels rdf:resource="http://example.org/emotion-aware-recommendation#Sadness"/>
        <emotion-aware-recommendation:hasNeed rdf:resource="http://example.org/emotion-aware-recommendation#EmotionalSupport"/>
        <emotion-aware-recommendation:hasPersonality rdf:resource="http://example.org/emotion-aware-recommendation#Extrovert"/>
        <emotion-aware-recommendation:hasPreference rdf:resource="http://example.org/emotion-aware-recommendation#LikesMovies"/>
        <emotion-aware-recommendation:hasTimeContext rdf:resource="http://example.org/emotion-aware-recommendation#Evening"/>
        <emotion-aware-recommendation:isInEnvironment rdf:resource="http://example.org/emotion-aware-recommendation#WithFriends"/>
        <emotion-aware-recommendation:hasAge rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</emotion-aware-recommendation:hasAge>
        <rdfs:label xml:lang="en">Deniz</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#DistractingEffect -->


    <owl:NamedIndividual rdf:about="http://example.org/emotion-aware-recommendation#DistractingEffect">
        <rdf:type rdf:resource="http://example.org/emotion-aware-recommendation#Effect"/>
        <emotion-aware-recommendation:relievesEmotion rdf:resource="http://example.org/emotion-aware-recommendation#Boredom"/>
        <rdfs:label xml:lang="en">Distracting Effect</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/emotion-aware-recommendation#Distraction -->


