@prefix ex: <http://example.org/emotion-aware-recommendation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix schema: <https://schema.org/> .

################################################################
# Ontology Information
################################################################

ex:EmotionAwareRecommendationOntology rdf:type owl:Ontology ;
    rdfs:label "Emotion-Aware Intelligent Recommendation Ontology"@en ;
    rdfs:comment "An ontology for modeling personalized recommendations based on user emotions, needs, context, personality traits, preferences, content types, and content effects. Version 2 extends the ontology with dynamic emotion tracking, behavioral prediction, LLM-based population support, and session-level interaction modeling."@en ;
    dc:title "Emotion-Aware Intelligent Recommendation Ontology"@en ;
    dc:description "This ontology models an intelligent recommendation system that provides personalized content suggestions based on the user's emotional state, contextual situation, personality traits, and needs. Phase 2 adds DynamicEmotion, BehaviorProfile, EmotionSession, UserInteraction, and DataSource classes inspired by Norouzi et al. (2025) ontology population with LLMs and Fernandez et al. (2023) GRU-RNN behavioral prediction."@en ;
    dc:creator "Elif Özkanat"@en , "Büşra Pehlivanlar"@en , "Enes Ulucan"@en ;
    dc:publisher "Manisa Celal Bayar University"@en ;
    dc:created "2026-04-28"^^xsd:date ;
    dc:modified "2026-05-14"^^xsd:date ;
    dc:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.0.0" ;
    owl:priorVersion "1.0.0" ;
    vann:preferredNamespacePrefix "ex" ;
    vann:preferredNamespaceUri "http://example.org/emotion-aware-recommendation#" ;
    schema:codeRepository <https://github.com/elifozknt/emotion-aware-recommendation-ontology> .

#################################################################
# Classes  —  Phase 1 (unchanged)
#################################################################

ex:User rdf:type owl:Class ;
    rdfs:label "User"@en ;
    rdfs:comment "A person who receives recommendations from the system."@en .

ex:Emotion rdf:type owl:Class ;
    rdfs:label "Emotion"@en ;
    rdfs:comment "An emotional state experienced by a user. Inspired by the UniEmotion ontology (Kim 2013) and Kim & Lee (2015) emotion ontology for recommendation, emotions are categorized as Positive, Negative, or Neutral/Factual."@en .

# --- Emotion Sub-Classes (inspired by UniEmotion ontology — Kim 2013, and Kim & Lee 2015) ---

ex:PositiveEmotion rdf:type owl:Class ;
    rdfs:subClassOf ex:Emotion ;
    rdfs:label "Positive Emotion"@en ;
    rdfs:comment "An emotion associated with pleasant, favorable affective states. Corresponds to 'positive emotional tags' in the UniEmotion ontology (Kim 2013). Examples: happiness, excitement, contentment."@en .

ex:NegativeEmotion rdf:type owl:Class ;
    rdfs:subClassOf ex:Emotion ;
    rdfs:label "Negative Emotion"@en ;
    rdfs:comment "An emotion associated with unpleasant or unfavorable affective states. Corresponds to 'negative emotional tags' in the UniEmotion ontology (Kim 2013). Examples: stress, sadness, anxiety, tiredness."@en .

ex:NeutralEmotion rdf:type owl:Class ;
    rdfs:subClassOf ex:Emotion ;
    rdfs:label "Neutral Emotion"@en ;
    rdfs:comment "A factual or neutral affective state with neither strong positive nor negative valence. Corresponds to 'factual tags' in the UniEmotion ontology (Kim 2013). Examples: calmness, focus, boredom."@en .

ex:Need rdf:type owl:Class ;
    rdfs:label "Need"@en ;
    rdfs:comment "A user need that may arise from an emotional state."@en .

ex:Content rdf:type owl:Class ;
    rdfs:label "Content"@en ;
    rdfs:comment "A digital content item or activity that can be recommended to a user."@en .

ex:Recommendation rdf:type owl:Class ;
    rdfs:label "Recommendation"@en ;
    rdfs:comment "A personalized suggestion generated for a user."@en .

ex:Effect rdf:type owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:comment "The expected psychological or behavioral effect of a content item."@en .

ex:Context rdf:type owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "The situation in which the user is located."@en .

ex:TimeContext rdf:type owl:Class ;
    rdfs:subClassOf ex:Context ;
    rdfs:label "Time Context"@en ;
    rdfs:comment "The time-related context of a user."@en .

ex:Environment rdf:type owl:Class ;
    rdfs:subClassOf ex:Context ;
    rdfs:label "Environment"@en ;
    rdfs:comment "The physical or social environment of a user."@en .

ex:Personality rdf:type owl:Class ;
    rdfs:label "Personality"@en ;
    rdfs:comment "A personality trait based on the Big Five model that may affect recommendation suitability. Sub-classes represent the primary personality dimensions relevant to emotion-based recommendation."@en .

# --- Personality Sub-Classes (Big Five inspired) ---

ex:IntrovertedPersonality rdf:type owl:Class ;
    rdfs:subClassOf ex:Personality ;
    rdfs:label "Introverted Personality"@en ;
    rdfs:comment "A personality type characterized by preference for solitary activities, deep focus, and low-stimulation environments. Introverted users tend to prefer calm, solo content (e.g., lo-fi music, meditation, solo games)."@en .

ex:ExtrovertedPersonality rdf:type owl:Class ;
    rdfs:subClassOf ex:Personality ;
    rdfs:label "Extroverted Personality"@en ;
    rdfs:comment "A personality type characterized by sociability, high energy, and preference for stimulating environments. Extroverted users tend to prefer social, upbeat, or group-oriented content (e.g., party playlists, group films)."@en .

ex:AgreeablePersonality rdf:type owl:Class ;
    rdfs:subClassOf ex:Personality ;
    rdfs:label "Agreeable Personality"@en ;
    rdfs:comment "A personality type characterized by cooperativeness, empathy, and trust. Agreeable users tend to enjoy emotionally warm content (e.g., feel-good movies, collaborative games, uplifting podcasts)."@en .

ex:NeuroticlPersonality rdf:type owl:Class ;
    rdfs:subClassOf ex:Personality ;
    rdfs:label "Neurotic Personality"@en ;
    rdfs:comment "A personality type characterized by emotional instability and high sensitivity to stress. Neurotic users benefit most from calming, grounding content (e.g., meditation, nature soundscapes, breathing exercises)."@en .

ex:OpennessPersonality rdf:type owl:Class ;
    rdfs:subClassOf ex:Personality ;
    rdfs:label "Openness Personality"@en ;
    rdfs:comment "A personality type characterized by curiosity, creativity, and appreciation of art. Users high in openness tend to enjoy diverse, novel, or artistic content (e.g., experimental music, documentaries, creative games)."@en .

ex:ConscientiousPersonality rdf:type owl:Class ;
    rdfs:subClassOf ex:Personality ;
    rdfs:label "Conscientious Personality"@en ;
    rdfs:comment "A personality type characterized by organization, goal-directedness, and discipline. Conscientious users prefer structured, purposeful content (e.g., educational podcasts, productivity music, self-improvement content)."@en .

ex:Preference rdf:type owl:Class ;
    rdfs:label "Preference"@en ;
    rdfs:comment "A user's preferred content type or activity."@en .

ex:ContentCategory rdf:type owl:Class ;
    rdfs:label "Content Category"@en ;
    rdfs:comment "A category describing the type of content."@en .

ex:Platform rdf:type owl:Class ;
    rdfs:label "Platform"@en ;
    rdfs:comment "A digital platform where content may be delivered."@en .

ex:Intention rdf:type owl:Class ;
    rdfs:label "Intention"@en ;
    rdfs:comment "The intended purpose of a recommendation."@en .

ex:Feedback rdf:type owl:Class ;
    rdfs:label "Feedback"@en ;
    rdfs:comment "A user response to a recommendation."@en .

#################################################################
# NEW Classes  —  Phase 2 Extensions
#################################################################

# --- Dynamic Emotion (inspired by GRU-RNN behavioral prediction) ---
ex:DynamicEmotion rdf:type owl:Class ;
    rdfs:subClassOf ex:Emotion ;
    rdfs:label "Dynamic Emotion"@en ;
    rdfs:comment "An emotion state that changes over time and is tracked across multiple sessions. Inspired by the temporal behavioral modeling in Fernandez et al. (2023) GRU-RNN framework, which predicts evolving user behavior styles across sessions."@en .

# --- Behavior Profile (maps to GRU-RNN behavior classes) ---
ex:BehaviorProfile rdf:type owl:Class ;
    rdfs:label "Behavior Profile"@en ;
    rdfs:comment "A classification of the user's interaction behavior style, analogous to the four behavioral classes (Cognitive, Speed, Sedentary, Aggressive) predicted by Fernandez et al. (2023). Used to personalize recommendation frequency and content depth."@en .

# --- Emotion Session (tracks a bounded interaction episode) ---
ex:EmotionSession rdf:type owl:Class ;
    rdfs:label "Emotion Session"@en ;
    rdfs:comment "A bounded time window during which a user's emotional state and interactions are recorded. Enables longitudinal modeling of emotion change, supporting the dynamic emotion tracking capability."@en .

# --- User Interaction (records a single content interaction event) ---
ex:UserInteraction rdf:type owl:Class ;
    rdfs:label "User Interaction"@en ;
    rdfs:comment "A single recorded interaction event between a user and a recommended content item (e.g., play, skip, complete). Used to populate ontology instances from log data, as described in the LLM-based ontology population approach of Norouzi et al. (2025)."@en .

# --- Data Source (documents provenance for LLM-based population) ---
ex:DataSource rdf:type owl:Class ;
    rdfs:label "Data Source"@en ;
    rdfs:comment "A source of data used to populate the ontology with instances (e.g., Kaggle dataset, Spotify API, survey). Supports the data provenance tracking recommended by Norouzi et al. (2025) for LLM-based knowledge graph population."@en .

#################################################################
# Object Properties  —  Phase 1 (unchanged)
#################################################################

ex:feels rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:Emotion ;
    rdfs:label "feels"@en ;
    rdfs:comment "Connects a user to an emotion they experience."@en .

ex:createsNeed rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Emotion ;
    rdfs:range ex:Need ;
    rdfs:label "creates need"@en ;
    rdfs:comment "Connects an emotion to the need it may create."@en .

ex:hasNeed rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:Need ;
    rdfs:label "has need"@en ;
    rdfs:comment "Connects a user to a need."@en .

ex:satisfiedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Need ;
    rdfs:range ex:Content ;
    rdfs:label "satisfied by"@en ;
    rdfs:comment "Connects a need to content that can satisfy it."@en .

ex:hasEffect rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:Effect ;
    rdfs:label "has effect"@en ;
    rdfs:comment "Connects content to its expected effect."@en .

ex:relievesEmotion rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Effect ;
    rdfs:range ex:Emotion ;
    rdfs:label "relieves emotion"@en ;
    rdfs:comment "Connects an effect to an emotion it may help reduce."@en .

ex:belongsToCategory rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:ContentCategory ;
    rdfs:label "belongs to category"@en ;
    rdfs:comment "Connects content to its category."@en .

ex:hasPreference rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:Preference ;
    rdfs:label "has preference"@en ;
    rdfs:comment "Connects a user to a preference."@en .

ex:matchesPreference rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:Preference ;
    rdfs:label "matches preference"@en ;
    rdfs:comment "Connects content to a matching user preference."@en .

ex:hasPersonality rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:Personality ;
    rdfs:label "has personality"@en ;
    rdfs:comment "Connects a user to a personality trait."@en .

ex:suitableForPersonality rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:Personality ;
    rdfs:label "suitable for personality"@en ;
    rdfs:comment "Shows which personality type a content item is suitable for."@en .

ex:hasTimeContext rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:TimeContext ;
    rdfs:label "has time context"@en ;
    rdfs:comment "Connects a user to a time context."@en .

ex:isInEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:Environment ;
    rdfs:label "is in environment"@en ;
    rdfs:comment "Connects a user to an environment."@en .

ex:suitableForTime rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:TimeContext ;
    rdfs:label "suitable for time"@en ;
    rdfs:comment "Shows which time context is suitable for content."@en .

ex:suitableForEnvironment rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:Environment ;
    rdfs:label "suitable for environment"@en ;
    rdfs:comment "Shows which environment is suitable for content."@en .

ex:givenTo rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:User ;
    rdfs:label "given to"@en ;
    rdfs:comment "Connects a recommendation to the user receiving it."@en .

ex:includesContent rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:Content ;
    rdfs:label "includes content"@en ;
    rdfs:comment "Connects a recommendation to the content it includes."@en .

ex:basedOnEmotion rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:Emotion ;
    rdfs:label "based on emotion"@en ;
    rdfs:comment "Shows the emotion considered in a recommendation."@en .

ex:basedOnNeed rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:Need ;
    rdfs:label "based on need"@en ;
    rdfs:comment "Shows the need considered in a recommendation."@en .

ex:considersContext rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:Context ;
    rdfs:label "considers context"@en ;
    rdfs:comment "Shows contextual information used in a recommendation."@en .

ex:hasIntention rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:Intention ;
    rdfs:label "has intention"@en ;
    rdfs:comment "Shows the intended purpose of a recommendation."@en .

ex:availableOnPlatform rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Content ;
    rdfs:range ex:Platform ;
    rdfs:label "available on platform"@en ;
    rdfs:comment "Connects content to the platform where it is available."@en .

ex:hasFeedback rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range ex:Feedback ;
    rdfs:label "has feedback"@en ;
    rdfs:comment "Connects a recommendation to user feedback."@en .

#################################################################
# NEW Object Properties  —  Phase 2 Extensions
#################################################################

ex:hasDynamicEmotion rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:DynamicEmotion ;
    rdfs:label "has dynamic emotion"@en ;
    rdfs:comment "Connects a user to a temporally-tracked dynamic emotion state recorded within a session."@en .

ex:hasBehaviorProfile rdf:type owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range ex:BehaviorProfile ;
    rdfs:label "has behavior profile"@en ;
    rdfs:comment "Connects a user to their predicted behavior profile (e.g., Cognitive, Speed, Sedentary, Aggressive), as classified by the GRU-RNN behavioral model described in Fernandez et al. (2023)."@en .

ex:recordedInSession rdf:type owl:ObjectProperty ;
    rdfs:domain ex:DynamicEmotion ;
    rdfs:range ex:EmotionSession ;
    rdfs:label "recorded in session"@en ;
    rdfs:comment "Links a dynamic emotion observation to the session in which it was recorded."@en .

ex:hasInteraction rdf:type owl:ObjectProperty ;
    rdfs:domain ex:EmotionSession ;
    rdfs:range ex:UserInteraction ;
    rdfs:label "has interaction"@en ;
    rdfs:comment "Connects an emotion session to individual user interaction events within it."@en .

ex:interactedWith rdf:type owl:ObjectProperty ;
    rdfs:domain ex:UserInteraction ;
    rdfs:range ex:Content ;
    rdfs:label "interacted with"@en ;
    rdfs:comment "Connects an interaction event to the content item the user acted on."@en .

ex:changesOverTime rdf:type owl:ObjectProperty ;
    rdfs:domain ex:DynamicEmotion ;
    rdfs:range ex:DynamicEmotion ;
    rdfs:label "changes over time"@en ;
    rdfs:comment "Links two dynamic emotion states to represent temporal transitions, enabling temporal reasoning over emotional trajectories."@en .

ex:populatedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain ex:UserInteraction ;
    rdfs:range ex:DataSource ;
    rdfs:label "populated from"@en ;
    rdfs:comment "Documents the data source from which this interaction instance was extracted, supporting the provenance tracking approach of Norouzi et al. (2025)."@en .

ex:derivedFromContext rdf:type owl:ObjectProperty ;
    rdfs:domain ex:DynamicEmotion ;
    rdfs:range ex:Context ;
    rdfs:label "derived from context"@en ;
    rdfs:comment "Links a dynamic emotion state to the contextual factors (time, environment) that contributed to it."@en .

#################################################################
# Data Properties  —  Phase 1 (unchanged)
#################################################################

ex:hasAge rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:User ;
    rdfs:range xsd:integer ;
    rdfs:label "has age"@en .

ex:hasConfidenceScore rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Recommendation ;
    rdfs:range xsd:decimal ;
    rdfs:label "has confidence score"@en .

ex:hasDurationMinutes rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Content ;
    rdfs:range xsd:integer ;
    rdfs:label "has duration in minutes"@en .

ex:hasFeedbackScore rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Feedback ;
    rdfs:range xsd:integer ;
    rdfs:label "has feedback score"@en .

#################################################################
# NEW Data Properties  —  Phase 2 Extensions
#################################################################

ex:hasIntensityLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:DynamicEmotion ;
    rdfs:range xsd:decimal ;
    rdfs:label "has intensity level"@en ;
    rdfs:comment "A numeric score (0.0–1.0) representing the intensity of a dynamic emotion at the time of observation."@en .

ex:hasTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:EmotionSession ;
    rdfs:range xsd:dateTime ;
    rdfs:label "has timestamp"@en ;
    rdfs:comment "The date-time when the emotion session was recorded."@en .

ex:hasInteractionType rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:UserInteraction ;
    rdfs:range xsd:string ;
    rdfs:label "has interaction type"@en ;
    rdfs:comment "The type of user interaction (e.g., 'play', 'skip', 'complete', 'like')."@en .

ex:hasSourceURL rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:DataSource ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has source URL"@en ;
    rdfs:comment "The URL of the data source used for ontology population."@en .

#################################################################
# Individuals — Phase 1 (all retained)
#################################################################

ex:Elif rdf:type ex:User ;
    rdfs:label "Elif"@en ;
    ex:hasAge 21 ;
    ex:feels ex:Stress ;
    ex:hasNeed ex:Relaxation ;
    ex:hasPersonality ex:Introvert ;
    ex:hasPreference ex:LikesMusic ;
    ex:hasPreference ex:LikesShortContent ;
    ex:hasTimeContext ex:Night ;
    ex:isInEnvironment ex:Home ;
    ex:isInEnvironment ex:Alone .

ex:Busra rdf:type ex:User ;
    rdfs:label "Büşra"@en ;
    ex:hasAge 22 ;
    ex:feels ex:Boredom ;
    ex:hasNeed ex:Distraction ;
    ex:hasPersonality ex:Extrovert ;
    ex:hasPreference ex:LikesGames ;
    ex:hasTimeContext ex:Evening ;
    ex:isInEnvironment ex:Home .

ex:Enes rdf:type ex:User ;
    rdfs:label "Enes"@en ;
    ex:hasAge 22 ;
    ex:feels ex:Tiredness ;
    ex:hasNeed ex:Motivation ;
    ex:hasPersonality ex:Introvert ;
    ex:hasPreference ex:LikesPodcasts ;
    ex:hasTimeContext ex:Morning ;
    ex:isInEnvironment ex:School .

ex:Deniz rdf:type ex:User ;
    rdfs:label "Deniz"@en ;
    ex:hasAge 23 ;
    ex:feels ex:Sadness ;
    ex:hasNeed ex:EmotionalSupport ;
    ex:hasPersonality ex:Extrovert ;
    ex:hasPreference ex:LikesMovies ;
    ex:hasTimeContext ex:Evening ;
    ex:isInEnvironment ex:WithFriends .

ex:Stress rdf:type ex:NegativeEmotion ;
    rdfs:label "Stress"@en ;
    ex:createsNeed ex:Relaxation .

ex:Sadness rdf:type ex:NegativeEmotion ;
    rdfs:label "Sadness"@en ;
    ex:createsNeed ex:EmotionalSupport .

ex:Anxiety rdf:type ex:NegativeEmotion ;
    rdfs:label "Anxiety"@en ;
    ex:createsNeed ex:Calmness .

ex:Tiredness rdf:type ex:NegativeEmotion ;
    rdfs:label "Tiredness"@en ;
    ex:createsNeed ex:Motivation .

ex:Boredom rdf:type ex:NeutralEmotion ;
    rdfs:label "Boredom"@en ;
    ex:createsNeed ex:Distraction .

ex:Relaxation rdf:type ex:Need ;
    rdfs:label "Relaxation"@en ;
    ex:satisfiedBy ex:LoFiPlaylist ;
    ex:satisfiedBy ex:BreathingExercise .

ex:EmotionalSupport rdf:type ex:Need ;
    rdfs:label "Emotional Support"@en ;
    ex:satisfiedBy ex:ComfortMovie .

ex:Calmness rdf:type ex:Need ;
    rdfs:label "Calmness"@en ;
    ex:satisfiedBy ex:MeditationAudio .

ex:Motivation rdf:type ex:Need ;
    rdfs:label "Motivation"@en ;
    ex:satisfiedBy ex:MotivationalPodcast .

ex:Distraction rdf:type ex:Need ;
    rdfs:label "Distraction"@en ;
    ex:satisfiedBy ex:PuzzleGame .

ex:Music rdf:type ex:ContentCategory ; rdfs:label "Music"@en .
ex:Movie rdf:type ex:ContentCategory ; rdfs:label "Movie"@en .
ex:Podcast rdf:type ex:ContentCategory ; rdfs:label "Podcast"@en .
ex:Meditation rdf:type ex:ContentCategory ; rdfs:label "Meditation"@en .
ex:Game rdf:type ex:ContentCategory ; rdfs:label "Game"@en .

ex:LoFiPlaylist rdf:type ex:Content ;
    rdfs:label "Lo-Fi Playlist"@en ;
    ex:belongsToCategory ex:Music ;
    ex:hasEffect ex:CalmingEffect ;
    ex:matchesPreference ex:LikesMusic ;
    ex:suitableForPersonality ex:Introvert ;
    ex:suitableForTime ex:Night ;
    ex:suitableForEnvironment ex:Home ;
    ex:suitableForEnvironment ex:Alone ;
    ex:availableOnPlatform ex:Spotify ;
    ex:hasDurationMinutes 25 .

ex:BreathingExercise rdf:type ex:Content ;
    rdfs:label "Breathing Exercise"@en ;
    ex:belongsToCategory ex:Meditation ;
    ex:hasEffect ex:RelaxingEffect ;
    ex:suitableForPersonality ex:Introvert ;
    ex:suitableForTime ex:Night ;
    ex:suitableForEnvironment ex:Home ;
    ex:availableOnPlatform ex:MobileApp ;
    ex:hasDurationMinutes 5 .

ex:ComfortMovie rdf:type ex:Content ;
    rdfs:label "Comfort Movie"@en ;
    ex:belongsToCategory ex:Movie ;
    ex:hasEffect ex:EmotionalReliefEffect ;
    ex:matchesPreference ex:LikesMovies ;
    ex:suitableForPersonality ex:Extrovert ;
    ex:suitableForTime ex:Evening ;
    ex:suitableForEnvironment ex:WithFriends ;
    ex:availableOnPlatform ex:Netflix ;
    ex:hasDurationMinutes 95 .

ex:MeditationAudio rdf:type ex:Content ;
    rdfs:label "Meditation Audio"@en ;
    ex:belongsToCategory ex:Meditation ;
    ex:hasEffect ex:CalmingEffect ;
    ex:suitableForTime ex:Night ;
    ex:suitableForEnvironment ex:Home ;
    ex:availableOnPlatform ex:MobileApp ;
    ex:hasDurationMinutes 10 .

ex:MotivationalPodcast rdf:type ex:Content ;
    rdfs:label "Motivational Podcast"@en ;
    ex:belongsToCategory ex:Podcast ;
    ex:hasEffect ex:MotivatingEffect ;
    ex:matchesPreference ex:LikesPodcasts ;
    ex:suitableForTime ex:Morning ;
    ex:availableOnPlatform ex:Spotify ;
    ex:hasDurationMinutes 15 .

ex:PuzzleGame rdf:type ex:Content ;
    rdfs:label "Puzzle Game"@en ;
    ex:belongsToCategory ex:Game ;
    ex:hasEffect ex:DistractingEffect ;
    ex:matchesPreference ex:LikesGames ;
    ex:suitableForEnvironment ex:Home ;
    ex:availableOnPlatform ex:MobileApp ;
    ex:hasDurationMinutes 20 .

ex:CalmingEffect rdf:type ex:Effect ;
    rdfs:label "Calming Effect"@en ;
    ex:relievesEmotion ex:Stress ;
    ex:relievesEmotion ex:Anxiety .

ex:RelaxingEffect rdf:type ex:Effect ;
    rdfs:label "Relaxing Effect"@en ;
    ex:relievesEmotion ex:Stress .

ex:EmotionalReliefEffect rdf:type ex:Effect ;
    rdfs:label "Emotional Relief Effect"@en ;
    ex:relievesEmotion ex:Sadness .

ex:MotivatingEffect rdf:type ex:Effect ;
    rdfs:label "Motivating Effect"@en ;
    ex:relievesEmotion ex:Tiredness .

ex:DistractingEffect rdf:type ex:Effect ;
    rdfs:label "Distracting Effect"@en ;
    ex:relievesEmotion ex:Boredom .

ex:Morning rdf:type ex:TimeContext ; rdfs:label "Morning"@en .
ex:Evening rdf:type ex:TimeContext ; rdfs:label "Evening"@en .
ex:Night rdf:type ex:TimeContext ; rdfs:label "Night"@en .
ex:Home rdf:type ex:Environment ; rdfs:label "Home"@en .
ex:School rdf:type ex:Environment ; rdfs:label "School"@en .
ex:Alone rdf:type ex:Environment ; rdfs:label "Alone"@en .
ex:WithFriends rdf:type ex:Environment ; rdfs:label "With Friends"@en .
# Personality individuals — instances of proper sub-classes
ex:Introvert rdf:type ex:IntrovertedPersonality ;
    rdfs:label "Introvert"@en ;
    rdfs:comment "Introverted personality individual. Suitable for calm, solo, low-stimulation content."@en .

ex:Extrovert rdf:type ex:ExtrovertedPersonality ;
    rdfs:label "Extrovert"@en ;
    rdfs:comment "Extroverted personality individual. Suitable for social, energetic content."@en .

ex:AgreeableUser rdf:type ex:AgreeablePersonality ;
    rdfs:label "Agreeable User"@en ;
    rdfs:comment "Agreeable personality individual — enjoys emotionally warm, cooperative content."@en .

ex:NeuroticiUser rdf:type ex:NeuroticlPersonality ;
    rdfs:label "Neurotic User"@en ;
    rdfs:comment "Neurotic personality individual — benefits most from calming, grounding content."@en .

ex:OpenUser rdf:type ex:OpennessPersonality ;
    rdfs:label "Open User"@en ;
    rdfs:comment "High-openness personality individual — enjoys novel, artistic, experimental content."@en .

ex:ConscientiousUser rdf:type ex:ConscientiousPersonality ;
    rdfs:label "Conscientious User"@en ;
    rdfs:comment "Conscientious personality individual — prefers structured, educational content."@en .
ex:LikesMusic rdf:type ex:Preference ; rdfs:label "Likes Music"@en .
ex:LikesMovies rdf:type ex:Preference ; rdfs:label "Likes Movies"@en .
ex:LikesPodcasts rdf:type ex:Preference ; rdfs:label "Likes Podcasts"@en .
ex:LikesGames rdf:type ex:Preference ; rdfs:label "Likes Games"@en .
ex:LikesShortContent rdf:type ex:Preference ; rdfs:label "Likes Short Content"@en .
ex:Spotify rdf:type ex:Platform ; rdfs:label "Spotify"@en .
ex:Netflix rdf:type ex:Platform ; rdfs:label "Netflix"@en .
ex:MobileApp rdf:type ex:Platform ; rdfs:label "Mobile Application"@en .
ex:ReduceStress rdf:type ex:Intention ; rdfs:label "Reduce Stress"@en .
ex:ImproveMood rdf:type ex:Intention ; rdfs:label "Improve Mood"@en .
ex:IncreaseMotivation rdf:type ex:Intention ; rdfs:label "Increase Motivation"@en .

ex:Feedback001 rdf:type ex:Feedback ; rdfs:label "Positive feedback 001"@en ; ex:hasFeedbackScore 5 .
ex:Feedback002 rdf:type ex:Feedback ; rdfs:label "Positive feedback 002"@en ; ex:hasFeedbackScore 4 .
ex:Feedback003 rdf:type ex:Feedback ; rdfs:label "Positive feedback 003"@en ; ex:hasFeedbackScore 4 .
ex:Feedback004 rdf:type ex:Feedback ; rdfs:label "Positive feedback 004"@en ; ex:hasFeedbackScore 5 .

ex:Recommendation001 rdf:type ex:Recommendation ;
    rdfs:label "Stress relief music recommendation for Elif"@en ;
    ex:givenTo ex:Elif ;
    ex:includesContent ex:LoFiPlaylist ;
    ex:basedOnEmotion ex:Stress ;
    ex:basedOnNeed ex:Relaxation ;
    ex:considersContext ex:Night ;
    ex:considersContext ex:Home ;
    ex:considersContext ex:Alone ;
    ex:hasIntention ex:ReduceStress ;
    ex:hasFeedback ex:Feedback001 ;
    ex:hasConfidenceScore 0.92 .

ex:Recommendation002 rdf:type ex:Recommendation ;
    rdfs:label "Comfort movie recommendation for Deniz"@en ;
    ex:givenTo ex:Deniz ;
    ex:includesContent ex:ComfortMovie ;
    ex:basedOnEmotion ex:Sadness ;
    ex:basedOnNeed ex:EmotionalSupport ;
    ex:considersContext ex:Evening ;
    ex:considersContext ex:WithFriends ;
    ex:hasIntention ex:ImproveMood ;
    ex:hasFeedback ex:Feedback002 ;
    ex:hasConfidenceScore 0.87 .

ex:Recommendation003 rdf:type ex:Recommendation ;
    rdfs:label "Puzzle game recommendation for Büşra"@en ;
    ex:givenTo ex:Busra ;
    ex:includesContent ex:PuzzleGame ;
    ex:basedOnEmotion ex:Boredom ;
    ex:basedOnNeed ex:Distraction ;
    ex:considersContext ex:Evening ;
    ex:considersContext ex:Home ;
    ex:hasIntention ex:ImproveMood ;
    ex:hasFeedback ex:Feedback003 ;
    ex:hasConfidenceScore 0.81 .

ex:Recommendation004 rdf:type ex:Recommendation ;
    rdfs:label "Motivational podcast recommendation for Enes"@en ;
    ex:givenTo ex:Enes ;
    ex:includesContent ex:MotivationalPodcast ;
    ex:basedOnEmotion ex:Tiredness ;
    ex:basedOnNeed ex:Motivation ;
    ex:considersContext ex:Morning ;
    ex:considersContext ex:School ;
    ex:hasIntention ex:IncreaseMotivation ;
    ex:hasFeedback ex:Feedback004 ;
    ex:hasConfidenceScore 0.88 .

#################################################################
# NEW Individuals  —  Phase 2 Extensions
#################################################################

# Behavior Profiles (mapped from Fernandez et al. 2023 GRU-RNN classes)
ex:CognitiveBehavior rdf:type ex:BehaviorProfile ;
    rdfs:label "Cognitive Behavior"@en ;
    rdfs:comment "User who engages deeply with content, high intellectual processing."@en .

ex:SpeedBehavior rdf:type ex:BehaviorProfile ;
    rdfs:label "Speed Behavior"@en ;
    rdfs:comment "User who consumes content quickly, prefers short-form recommendations."@en .

ex:SedentaryBehavior rdf:type ex:BehaviorProfile ;
    rdfs:label "Sedentary Behavior"@en ;
    rdfs:comment "User with passive interaction patterns, low effort content preferred."@en .

ex:AggressiveBehavior rdf:type ex:BehaviorProfile ;
    rdfs:label "Aggressive Behavior"@en ;
    rdfs:comment "User who skips content frequently, indicating high selectivity or stress."@en .

# Dynamic Emotions for Elif (temporal change example)
ex:ElilStressHigh rdf:type ex:DynamicEmotion ;
    rdfs:label "Elif - High Stress at Night"@en ;
    ex:hasIntensityLevel 0.85 ;
    ex:derivedFromContext ex:Night ;
    ex:derivedFromContext ex:Alone .

ex:ElifStressLow rdf:type ex:DynamicEmotion ;
    rdfs:label "Elif - Low Stress After Listening"@en ;
    ex:hasIntensityLevel 0.30 ;
    ex:changesOverTime ex:ElilStressHigh .

# Assign dynamic emotions and behavior profiles to users
ex:Elif ex:hasDynamicEmotion ex:ElilStressHigh ;
    ex:hasBehaviorProfile ex:SpeedBehavior .

ex:Enes ex:hasDynamicEmotion ex:EnesLowMotivationMorning ;
    ex:hasBehaviorProfile ex:CognitiveBehavior .

ex:EnesLowMotivationMorning rdf:type ex:DynamicEmotion ;
    rdfs:label "Enes - Low Motivation in Morning"@en ;
    ex:hasIntensityLevel 0.65 ;
    ex:derivedFromContext ex:Morning ;
    ex:derivedFromContext ex:School .

# Emotion Sessions
ex:Session001 rdf:type ex:EmotionSession ;
    rdfs:label "Elif Evening Session 2026-05-14"@en ;
    ex:hasTimestamp "2026-05-14T21:30:00"^^xsd:dateTime ;
    ex:hasInteraction ex:Interaction001 ;
    ex:hasInteraction ex:Interaction002 .

# User Interactions
ex:Interaction001 rdf:type ex:UserInteraction ;
    rdfs:label "Elif plays LoFi Playlist"@en ;
    ex:hasInteractionType "play" ;
    ex:interactedWith ex:LoFiPlaylist ;
    ex:populatedFrom ex:SpotifyAPISource .

ex:Interaction002 rdf:type ex:UserInteraction ;
    rdfs:label "Elif completes Breathing Exercise"@en ;
    ex:hasInteractionType "complete" ;
    ex:interactedWith ex:BreathingExercise ;
    ex:populatedFrom ex:SpotifyAPISource .

# Dynamic Emotion linked to session
ex:ElilStressHigh ex:recordedInSession ex:Session001 .

# Data Sources
ex:SpotifyAPISource rdf:type ex:DataSource ;
    rdfs:label "Spotify Web API"@en ;
    rdfs:comment "User listening history and interaction logs collected via the Spotify Web API."@en ;
    ex:hasSourceURL <https://developer.spotify.com/documentation/web-api> .

ex:KaggleEmotionDataset rdf:type ex:DataSource ;
    rdfs:label "Kaggle Emotion-Music Dataset"@en ;
    rdfs:comment "Publicly available dataset mapping emotion labels to music features, used for ontology population."@en ;
    ex:hasSourceURL <https://www.kaggle.com/datasets/musicemotionrecognition> .
